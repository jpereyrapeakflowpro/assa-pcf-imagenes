    "@typescript-eslint/parser": "^5.39.0",
    "eslint": "^8.24.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.1",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "typescript": "^4.9.5",
    "vitest": "^3.2.4"
