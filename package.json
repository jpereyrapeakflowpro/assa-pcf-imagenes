{
  "name": "assa-pcf-image-viewer",
  "version": "1.0.0",
  "description": "PCF Base64 image viewer with multipage TIFF support for Power Apps.",
  "private": true,
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
